{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": [
    {
      "root": "netflix-backend",
      "framework": "express"
    },
    {
      "root": "netflix-frontend",
      "framework": "vite"
    }
  ],
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/netflix-backend/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/netflix-frontend/$1"
    }
  ]
}
