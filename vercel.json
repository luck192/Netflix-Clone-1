{
  "version": 2,
  "builds": [
    {
      "src": "netflix-frontend/package.json",
      "use": "@vercel/vite"
    },
    {
      "src": "netflix-backend/index.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "netflix-backend/index.js"
    },
    {
      "src": "/(.*)",
      "dest": "netflix-frontend/$1"
    }
  ]
}
